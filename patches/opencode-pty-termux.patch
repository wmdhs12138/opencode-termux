 fn resolve_socket_root(directory: Option<PathBuf>, uid: u32) -> Result<PathBuf> {
     let base = match directory {
-        None => PathBuf::from("/tmp"),
+        // opencode-termux: Android has no /tmp; Termux's is $PREFIX/tmp, whose
+        // socket paths (about 92 bytes) still fit.
+        None => std::env::var_os("PREFIX")
