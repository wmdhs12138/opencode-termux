+// opencode-termux: the NDK sysroot that Termux's ndk-multilib provides.
+fn androidSysroot(b: *std.Build) []const u8 {
+    const ndk = b.graph.environ_map.get("ANDROID_NDK_HOME") orelse std.debug.panic("ANDROID_NDK_HOME is not set", .{});
+    return b.pathJoin(&.{ ndk, "toolchains", "llvm", "prebuilt", "linux-x86_64", "sysroot", "usr" });
+}
+
+fn addAndroidIncludes(b: *std.Build, translate: *std.Build.Step.TranslateC) void {
+    const include = b.pathJoin(&.{ androidSysroot(b), "include" });
+    translate.addSystemIncludePath(.{ .cwd_relative = include });
+    translate.addSystemIncludePath(.{ .cwd_relative = b.pathJoin(&.{ include, "aarch64-linux-android" }) });
+}
+
+// opencode-termux: link against the NDK sysroot and raise PT_TLS alignment to
+// what Android's linker requires.
+fn addAndroidSysroot(b: *std.Build, lib: *std.Build.Step.Compile, module: *std.Build.Module) !void {
+    const sysroot = androidSysroot(b);
+    const include = b.pathJoin(&.{ sysroot, "include" });
+    const library = b.pathJoin(&.{ sysroot, "lib", "aarch64-linux-android" });
+    const files = b.addWriteFiles();
+    lib.setLibCFile(files.add("libc.txt", b.fmt(
+        \\include_dir={s}
+        \\sys_include_dir={s}/aarch64-linux-android
+        \\crt_dir={s}/24
+        \\msvc_lib_dir=
+        \\kernel32_lib_dir=
+        \\gcc_dir=
+    , .{ include, include, library })));
+    module.addSystemIncludePath(.{ .cwd_relative = b.pathJoin(&.{ include, "c++", "v1" }) });
+    module.addLibraryPath(.{ .cwd_relative = library });
+    const tls_align = b.graph.environ_map.get("OPENCODE_TERMUX_TLS_ALIGN") orelse return error.MissingTLSAlignmentAnchor;
+    module.addAssemblyFile(.{ .cwd_relative = tls_align });
+}
+
