@@ -0,0 +1,32 @@
+import { UI } from "../ui"
+import * as prompts from "@clack/prompts"
+import { InstallationVersion } from "@opencode-ai/core/installation/version"
+import { TermuxBuild } from "../../installation/termux"
+
+// opencode-termux: a read-only check; `opencode upgrade` installs.
+export const UpdateCommand = {
+  command: "update",
+  describe: "check for opencode updates",
+  handler: async () => {
+    UI.empty()
+    UI.println(UI.logo("  "))
+    UI.empty()
+    prompts.intro("Update")
+    const latest = await TermuxBuild.check().catch((err) => (err instanceof Error ? err : new Error(String(err))))
+    if (latest instanceof Error) {
+      prompts.log.error(`Update check failed: ${latest.message}`)
+      prompts.outro("Done")
+      return
+    }
+    prompts.log.info(`Current: ${InstallationVersion} (build ${latest.current.slice(0, 12)})`)
+    prompts.log.info(`Latest: ${latest.version} (build ${latest.build.slice(0, 12)})`)
+    if (InstallationVersion !== latest.version) {
+      prompts.log.warn(`Update available: ${latest.version}. Run opencode upgrade to install it.`)
+    } else if (latest.build && latest.build !== latest.current) {
+      prompts.log.warn(`A rebuilt OpenCode ${latest.version} is available. Run opencode upgrade to install it.`)
+    } else {
+      prompts.log.info("OpenCode is up to date")
+    }
+    prompts.outro("Done")
+  },
+}
