diff --git a/packages/opencode/src/installation/termux.ts b/packages/opencode/src/installation/termux.ts
new file mode 100644
index 0000000..8221e42
--- /dev/null
+++ b/packages/opencode/src/installation/termux.ts
@@ -0,0 +1,53 @@
+// opencode-termux: this build updates from the Bionic-verified releases of
+// wmdhs12138/opencode-termux, never from the official glibc packages.
+//
+// A release is vX.Y.Z or a re-cut vX.Y.Z-rN of the same OpenCode version (new
+// toolchain, same upstream code), so the version alone cannot tell two builds
+// apart. The explicit commands compare the running binary's SHA-256 with the
+// latest release's build-manifest.json instead. `Installation.latest()`, and
+// the TUI's background update check behind it, keeps comparing versions, so a
+// re-cut is offered but never reinstalled in the background.
+
+export const RELEASE_MANIFEST =
+  "https://github.com/wmdhs12138/opencode-termux/releases/latest/download/build-manifest.json"
+export const INSTALLER = "https://raw.githubusercontent.com/wmdhs12138/opencode-termux/main/install.sh"
+
+/** The Termux prefix the installer writes to; `opencode` installed there updates with it. */
+export function installedByInstaller(execPath = process.execPath) {
+  return execPath.startsWith((process.env.PREFIX ?? "/data/data/com.termux/files/usr") + "/bin/")
+}
+
+export type Build = {
+  /** Latest release's OpenCode version, without v */
+  version: string
+  /** Latest release's binary SHA-256 */
+  build: string
+  /** Running binary's SHA-256 */
+  current: string
+}
+
+/** Reads the latest release's manifest and hashes the running binary (about a second for ~200 MB). */
+export async function check(): Promise<Build> {
+  const response = await fetch(RELEASE_MANIFEST)
+  if (!response.ok) throw new Error(`HTTP ${response.status} from the release manifest`)
+  const manifest = (await response.json()) as { tag_name?: unknown; output_sha256?: unknown }
+  const hasher = new Bun.CryptoHasher("sha256")
+  for await (const chunk of Bun.file(process.execPath).stream()) hasher.update(chunk)
+  return {
+    version: String(manifest.tag_name ?? "").replace(/^v/, ""),
+    build: String(manifest.output_sha256 ?? ""),
+    current: hasher.digest("hex"),
+  }
+}
+
+/** Whether `version` is installed as the latest release's build. True when that cannot be told. */
+export async function sameBuild(version: string) {
+  try {
+    const latest = await check()
+    return latest.version !== version || !latest.build || latest.build === latest.current
+  } catch {
+    return true
+  }
+}
+
+export * as TermuxBuild from "./termux"
