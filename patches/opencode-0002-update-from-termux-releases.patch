diff --git a/packages/cli/src/termux.ts b/packages/cli/src/termux.ts
new file mode 100644
index 0000000..dddeba5
--- /dev/null
+++ b/packages/cli/src/termux.ts
@@ -0,0 +1,48 @@
+// opencode-termux: this build updates from the Bionic-verified releases of
+// wmdhs12138/opencode-termux, never from the official packages, which do not
+// run on Android.
+//
+// A release is vX.Y.Z or a re-cut vX.Y.Z-rN of the same OpenCode version (new
+// toolchain, same upstream code), so the version alone cannot tell two builds
+// apart. `opencode upgrade` compares the running binary's SHA-256 with the
+// latest release's build-manifest.json instead. The TUI's update check keeps
+// comparing versions, so a re-cut is offered but never installed unasked.
+
+export const RELEASE_MANIFEST =
+  "https://github.com/wmdhs12138/opencode-termux/releases/latest/download/build-manifest.json"
+export const INSTALLER = "https://raw.githubusercontent.com/wmdhs12138/opencode-termux/main/install.sh"
+
+/** The Termux prefix the installer writes to; `opencode` installed there updates with it. */
+export function installedByInstaller(executable = process.execPath) {
+  return executable.startsWith((process.env.PREFIX ?? "/data/data/com.termux/files/usr") + "/bin/")
+}
+
+async function manifest() {
+  const response = await fetch(RELEASE_MANIFEST, { signal: AbortSignal.timeout(10_000) })
+  if (!response.ok) throw new Error(`HTTP ${response.status} from the release manifest`)
+  const data = (await response.json()) as { tag_name?: unknown; output_sha256?: unknown }
+  const version = String(data.tag_name ?? "").replace(/^v/, "")
+  if (!version) throw new Error("The release manifest has no version")
+  return { version, build: String(data.output_sha256 ?? "") }
+}
+
+/** The latest release's OpenCode version, without v. */
+export async function latest() {
+  return (await manifest()).version
+}
+
+/** Whether `version` is installed as the latest release's build. True when that cannot be told. */
+export async function sameBuild(version: string) {
+  try {
+    const latest = await manifest()
+    if (latest.version !== version || !latest.build) return true
+    // About a second for the ~200 MB binary.
+    const hasher = new Bun.CryptoHasher("sha256")
+    for await (const chunk of Bun.file(process.execPath).stream()) hasher.update(chunk)
+    return hasher.digest("hex") === latest.build
+  } catch {
+    return true
+  }
+}
+
+export * as TermuxBuild from "./termux"
